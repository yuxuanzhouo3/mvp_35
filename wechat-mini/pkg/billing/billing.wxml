<view class="page">
  <text class="eyebrow">账单</text>
  <view class="h1">套餐与微信支付</view>
  <view class="copy">下单后状态是待支付。入账以后台签名回调为准。小程序里用微信支付。</view>
  <view class="warn" wx:if="{{testing}}">当前是支付测试，付费套餐实付 0.10 元。</view>
  <view class="err" wx:if="{{error}}">{{error}}</view>
  <view class="ok" wx:if="{{notice}}">{{notice}}</view>
  <view class="muted" wx:if="{{active}}">当前订阅：{{active}}</view>
  <view class="item" wx:for="{{plans}}" wx:key="id">
    <view class="h2">{{item.name}}</view>
    <view class="muted">{{item.price}} / {{item.period}}</view>
    <button class="wx-btn" wx:if="{{item.payable}}" disabled="{{busy}}" data-id="{{item.id}}" bindtap="checkout">
      <image class="wx-logo" src="/assets/wechat.png" mode="aspectFit" />
      <text>微信支付</text>
    </button>
    <view class="muted" wx:else>免费档不产生支付单。</view>
  </view>
  <view class="h2" style="margin-top: 28rpx;">支付记录</view>
  <view class="item" wx:for="{{payments}}" wx:key="id">
    <view>{{item.amount}} · {{item.statusLabel}}</view>
    <button class="btn-line" wx:if="{{item.pending}}" disabled="{{busy}}" data-id="{{item.id}}" bindtap="query">查询入账</button>
  </view>
  <view class="muted" wx:if="{{payments.length == 0}}">还没有支付记录。</view>
  <view class="h2" style="margin-top: 28rpx;">发票</view>
  <view class="item" wx:for="{{invoices}}" wx:key="id">{{item.id}} · {{item.amount}} · {{item.statusLabel}}</view>
  <view class="muted" wx:if="{{invoices.length == 0}}">入账后才会开票。</view>
</view>
