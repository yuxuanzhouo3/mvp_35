AUTH_MODE=demo
# json keeps the local file. cloudbase writes the remote PostgreSQL documents table.
STORAGE_ENGINE=json
CLOUDBASE_ENV_ID=mvp35-d6g2zp4539a542ebc
CLOUDBASE_REGION=ap-shanghai
DATA_PATH=data/store.json
HUNYUAN_ENABLED=false
TONGYI_ENABLED=false
HUNYUAN_API_KEY=
SES_MODE=mock
# live uses the merchant values in the private .env. Empty keys keep checkout pending.
WECHAT_PAY_MODE=live
# Merchant app id, mch id, serial, private key and API v3 key stay out of git.
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=https://pickglobal.mornscience.top/api/v1/webhooks/wechat-pay
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_OAUTH_STATE_SECRET=
WECHAT_OAUTH_REDIRECT=https://pickglobal.mornscience.top/login/wechat
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=465
AUTH_EMAIL_SMTP_USER=
AUTH_EMAIL_SMTP_PASS=
AUTH_EMAIL_FROM=
PUBLIC_WEB_ORIGIN=https://pickglobal.mornscience.top
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
SMS_REGION=ap-guangzhou
# App id, private key, Alipay public key, and AES key live in the private .env.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_AES_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://pickglobal.mornscience.top/api/v1/webhooks/alipay
# 0 keeps the catalog price. 10 charges 0.10 yuan on paid plans while testing.
PAYMENT_TEST_AMOUNT_FEN=0
LEDGER_HMAC_SECRET=demo-ledger-secret
DEMO_SIGNING_HELPER=true
WORKER_TOKEN=demo-worker
QUALITY_THRESHOLD=60
# ECB USD/CNY via Frankfurter. Empty keeps the rate stored on the product.
FX_API_URL=https://api.frankfurter.dev/v1/latest
# Optional global-goods pricer. DxPhi shape: GET ?product=&country= and X-Api-Key.
# Empty keeps the local shelf book.
PRICER_API_URL=
PRICER_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
