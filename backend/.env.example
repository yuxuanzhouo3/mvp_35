AUTH_MODE=demo
# json keeps the local file. cloudbase writes the remote PostgreSQL documents table.
STORAGE_ENGINE=json
CLOUDBASE_ENV_ID=mvp35-d6g2zp4539a542ebc
CLOUDBASE_REGION=ap-shanghai
DATA_PATH=data/store.json
HUNYUAN_ENABLED=false
TONGYI_ENABLED=false
HUNYUAN_API_KEY=
TONGYI_API_KEY=
# Real LLM for 客服 and AI 选品. Leave keys empty until gathered.
# Provider: hunyuan | tongyi | openai
AI_ENABLED=false
AI_PROVIDER=hunyuan
AI_API_KEY=
# Optional overrides. Empty uses the provider default endpoint and model.
AI_BASE_URL=
AI_MODEL=
SES_MODE=mock
# live uses the merchant values in the private .env. Empty keys keep checkout pending.
WECHAT_PAY_MODE=live
# Merchant app id, mch id, serial, private key and API v3 key stay out of git.
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_NOTIFY_URL=https://pickglobal.mornscience.top/api/v1/webhooks/wechat-pay
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MINIPROGRAM_APP_ID=
WECHAT_MINIPROGRAM_APP_SECRET=
WECHAT_OAUTH_STATE_SECRET=
WECHAT_OAUTH_REDIRECT=https://pickglobal.mornscience.top/login/wechat
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=465
AUTH_EMAIL_SMTP_USER=
AUTH_EMAIL_SMTP_PASS=
AUTH_EMAIL_FROM=
PUBLIC_WEB_ORIGIN=https://pickglobal.mornscience.top
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
SMS_REGION=ap-guangzhou
# App id, private key, Alipay public key, and AES key live in the private .env.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_ALIPAY_PUBLIC_KEY=
ALIPAY_AES_KEY=
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=https://pickglobal.mornscience.top/api/v1/webhooks/alipay
# 0 keeps the catalog price. 10 charges 0.10 yuan on paid plans while testing.
PAYMENT_TEST_AMOUNT_FEN=0
LEDGER_HMAC_SECRET=demo-ledger-secret
DEMO_SIGNING_HELPER=true
WORKER_TOKEN=demo-worker
QUALITY_THRESHOLD=60
# ECB USD/CNY via Frankfurter. Empty keeps the rate stored on the product.
FX_API_URL=https://api.frankfurter.dev/v1/latest
# Optional global-goods pricer. DxPhi shape: GET ?product=&country= and X-Api-Key.
# Empty keeps the local shelf book.
PRICER_API_URL=
PRICER_API_KEY=
# Official goods APIs for 帮我选品. Empty skips that platform and keeps the local catalog.
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
# access_token 约 10 小时。到期后用 refresh_token 换新的。refresh_token_timeout 过后必须重新授权。
ALIBABA_REFRESH_TOKEN=
ALIBABA_REFRESH_TOKEN_TIMEOUT=
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_ADZONE_ID=
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=
JD_APP_KEY=
JD_APP_SECRET=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
WALMART_PUBLISHER_ID=
WALMART_CONSUMER_ID=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Production keyset stays disabled until this endpoint answers eBay's challenge.
# Token is 32–80 characters. The endpoint string must match the portal exactly.
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=https://pickglobal.mornscience.top/api/v1/webhooks/ebay-account-deletion
# AliExpress affiliate. USD shelf price for selection. tracking_id is the PID from the affiliate console.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# TikTok Shop Partner Center → App → App Key / App Secret; OAuth → Access Token + Shop Cipher.
# Affiliate open-collaboration product search. Empty skips the shelf.
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=
TIKTOK_SHOP_SHOP_CIPHER=
# After OAuth, B1–B4 may seed a post, reply at most once per thread, and pull that account's own fans.
REPLY_INTERVAL_HOURS=24
# ---------------------------------------------------------------------------
# B1–B5 developer App keys (system-wide). Sellers authorize in-app; their
# access/refresh tokens are stored per tenant on channel_accounts.
# Optional *_ACCESS_TOKEN / *_SESSION / *_REFRESH_TOKEN below are bootstrap
# fallbacks only (single-tenant ops). Prefer per-user OAuth.
# Apply / docs: see workflow or product docs for official portals.
# Callback: {PUBLIC_WEB_ORIGIN}/workspace/acquire/connected
# ---------------------------------------------------------------------------
# B1 ecommerce App keys
AMAZON_SP_APPLICATION_ID=
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
WALMART_MARKET_CLIENT_ID=
WALMART_MARKET_CLIENT_SECRET=
TAOBAO_SESSION=
PDD_ACCESS_TOKEN=
# Temu Partner App. Seller OAuth: seller.temu.com/.../authorization ; or paste access_token.
TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=
TEMU_OPEN_HOST=https://openapi-b-us.temu.com
# B2 social App keys. WeCom uses pasted corp_id / contact_secret / follow_userid per tenant.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AD_ACCOUNT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
WECOM_CORP_ID=
WECOM_CONTACT_SECRET=
WECOM_FOLLOW_USERID=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
DOUYIN_ACCESS_TOKEN=
XHS_APP_ID=
XHS_APP_SECRET=
XHS_ACCESS_TOKEN=
KUAISHOU_APP_ID=
KUAISHOU_APP_SECRET=
KUAISHOU_ACCESS_TOKEN=
# B3 Alibaba.com App keys. Canton Fair / Global Sources / CIIE / online_expo: no public OAuth.
ALIBABA_INTL_APP_KEY=
ALIBABA_INTL_APP_SECRET=
ALIBABA_INTL_ACCESS_TOKEN=
# B4 parent of agent_1..agent_12. Empty rejects a push with no parent.
AGENCY_PARENT_ACCOUNT_ID=
# B5 company API keys (system). Tenants may paste their own keys instead.
QICHACHA_APP_KEY=
QICHACHA_SECRET_KEY=
TIANYANCHA_TOKEN=
QIXIN_APP_KEY=
QIXIN_SECRET_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
